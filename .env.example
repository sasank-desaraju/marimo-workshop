# Copy to .env (git-ignored) and fill in:  cp .env.example .env
# marimo loads this file automatically for notebooks in this repo.

# NaviGator AI key for marimo's chat panel (see pyproject.toml).
# TODO(HPG): link to where users request/generate a key.
NAVIGATOR_API_KEY=

# Optional: an MLflow server to log to. Leave unset to use the one started by
# scripts/mlflow_server.sbatch (found via mlruns/server.env), or CSV only.
# MLFLOW_TRACKING_URI=http://localhost:5000
# MLFLOW_EXPERIMENT_NAME=mnist1d-workshop
